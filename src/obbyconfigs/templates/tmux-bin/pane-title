#!/usr/bin/env bash
set -euo pipefail
shopt -s nocasematch

tty_path="${1:-}"
fallback="${2:-shell}"
current_hint="${3:-}"

case "${current_hint##*/}" in
  codex|codex-*|codex_linux*|codex.exe)
    printf 'codex\n'
    exit 0
    ;;
  claude|claude-code|claude.exe)
    printf 'claude\n'
    exit 0
    ;;
  kimi|kimi-code|kimi-cli|kimi.exe|kimi-code.exe)
    printf 'kimi\n'
    exit 0
    ;;
  sh|bash|zsh|fish|dash|ksh)
    printf '%s\n' "$fallback"
    exit 0
    ;;
esac

tty_name="${tty_path#/dev/}"
if [[ -z "$tty_name" || "$tty_name" == "$tty_path" || "$tty_name" == -* || "$tty_name" =~ [^[:alnum:]_./-] ]]; then
  printf '%s\n' "$fallback"
  exit 0
fi

processes="$(ps -t "$tty_name" -o pid=,ppid=,stat=,comm=,args= 2>/dev/null || true)"
if [[ -z "$processes" ]]; then
  printf '%s\n' "$fallback"
  exit 0
fi
agent_label=""
runtime_label=""
leader_comm=""

agent_from_process() {
  local comm_value="${1##*/}"
  local args_value="$2"

  case "$comm_value" in
    codex|codex-*|codex_linux*|codex.exe)
      printf 'codex\n'
      return
      ;;
    claude|claude-code|claude.exe)
      printf 'claude\n'
      return
      ;;
    kimi|kimi-code|kimi-cli|kimi.exe|kimi-code.exe)
      printf 'kimi\n'
      return
      ;;
  esac

  # npm-installed AI CLIs commonly leave `node` as tmux's current command.
  # Match their executable/module paths, not arbitrary prompt text.
  if [[ "$args_value" =~ (^|[[:space:]])[^[:space:]]*/(@openai/)?codex(/|$|[[:space:]]) ]] ||
    [[ "$args_value" =~ /@openai/codex/ ]] ||
    [[ "$args_value" =~ /codex-linux-[^/[:space:]]*/codex($|[[:space:]]) ]] ||
    [[ "$args_value" =~ (^|[[:space:]])(npm|npx|pnpm|pnpx|yarn|yarnpkg|bunx|corepack)([[:space:]]+(exec|dlx|x))?[[:space:]]+(@openai/)?codex(@[^[:space:]]*)?($|[[:space:]]) ]]; then
    printf 'codex\n'
  elif [[ "$args_value" =~ (^|[[:space:]])[^[:space:]]*/claude($|[[:space:]]) ]] ||
    [[ "$args_value" =~ /@anthropic-ai/claude-code/ ]] ||
    [[ "$args_value" =~ /claude-code/(cli|bin)(\.js)?($|[[:space:]]) ]] ||
    [[ "$args_value" =~ (^|[[:space:]])(npm|npx|pnpm|pnpx|yarn|yarnpkg|bunx|corepack)([[:space:]]+(exec|dlx|x))?[[:space:]]+(@anthropic-ai/)?claude(-code)?(@[^[:space:]]*)?($|[[:space:]]) ]]; then
    printf 'claude\n'
  elif [[ "$args_value" =~ (^|[[:space:]])[^[:space:]]*/kimi(-code|-cli)?($|[[:space:]]) ]] ||
    [[ "$args_value" =~ /@moonshot-ai/kimi[^/]*/ ]] ||
    [[ "$args_value" =~ /kimi-(code|cli)/(cli|bin)(\.js)?($|[[:space:]]) ]] ||
    [[ "$args_value" =~ (^|[[:space:]])(npm|npx|pnpm|pnpx|yarn|yarnpkg|bunx|corepack)([[:space:]]+(exec|dlx|x))?[[:space:]]+(@moonshot-ai/)?kimi(-code|-cli)?(@[^[:space:]]*)?($|[[:space:]]) ]]; then
    printf 'kimi\n'
  fi
}

runtime_from_process() {
  local comm_value="${1##*/}"
  local args_value="$2"

  case "$comm_value" in
    node|nodejs|bun|deno)
      if [[ "$args_value" =~ (^|[[:space:]/])vite($|[[:space:]/]) ]]; then
        printf 'vite\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])next($|[[:space:]/]) ]]; then
        printf 'next\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])astro($|[[:space:]/]) ]]; then
        printf 'astro\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])tsx($|[[:space:]/]) ]]; then
        printf 'tsx\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])ts-node($|[[:space:]/]) ]]; then
        printf 'ts-node\n'
      fi
      ;;
    python|python3|python[0-9]*)
      if [[ "$args_value" =~ (^|[[:space:]/])uvicorn($|[[:space:]/]) ]]; then
        printf 'uvicorn\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])gunicorn($|[[:space:]/]) ]]; then
        printf 'gunicorn\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])pytest($|[[:space:]/]) ]]; then
        printf 'pytest\n'
      elif [[ "$args_value" =~ (^|[[:space:]/])django-admin($|[[:space:]/]) ]]; then
        printf 'django\n'
      fi
      ;;
  esac
}

while read -r _pid _ppid stat comm args; do
  [[ "$stat" == *+* ]] || continue
  args="${args:-$comm}"

  # ps normally lists the foreground process-group leader first. Preserve it
  # as the generic fallback, while scanning every foreground member for a
  # meaningful CLI. Agent CLIs often spawn same-group Node MCP children.
  if [[ -z "$leader_comm" ]]; then
    leader_comm="$comm"
  fi

  if [[ -z "$agent_label" ]]; then
    agent_label="$(agent_from_process "$comm" "$args")"
  fi
  if [[ -z "$runtime_label" ]]; then
    runtime_label="$(runtime_from_process "$comm" "$args")"
  fi
done <<<"$processes"

if [[ -n "$agent_label" ]]; then
  printf '%s\n' "$agent_label"
  exit 0
fi

if [[ -n "$runtime_label" ]]; then
  printf '%s\n' "$runtime_label"
  exit 0
fi

if [[ -z "$leader_comm" ]]; then
  printf '%s\n' "$fallback"
  exit 0
fi

case "${leader_comm##*/}" in
  sh|bash|zsh|fish|dash|ksh)
    printf '%s\n' "$fallback"
    ;;
  *)
    printf '%s\n' "$leader_comm"
    ;;
esac
